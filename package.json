{
  "name": "seo-gate",
  "version": "0.1.0",
  "description": "Automated SEO Regression Guard for CI/CD",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "seo-gate": "dist/cli/index.js"
  },
  "files": [
    "dist",
    "action.yml",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/majhiiii/seo-gate.git"
  },
  "bugs": {
    "url": "https://github.com/majhiiii/seo-gate/issues"
  },
  "homepage": "https://github.com/majhiiii/seo-gate#readme",
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "docs:check": "tsx scripts/check-docs.ts",
    "prepublishOnly": "pnpm build && pnpm test",
    "seo-gate": "tsx src/cli/index.ts"
  },
  "keywords": [
    "seo",
    "ci",
    "cd",
    "regression",
    "gate",
    "quality"
  ],
  "author": "",
  "license": "MIT",
  "packageManager": "pnpm@12.21.0",
  "dependencies": {
    "cheerio": "^1.2.0",
    "commander": "^15.1.0",
    "lighthouse": "^13.6.0",
    "picocolors": "^1.1.1",
    "playwright": "^1.65.1",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^5.1.1",
    "express": "^5.3.0",
    "fast-glob": "^3.3.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  }
}
