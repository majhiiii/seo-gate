{
  "name": "seo-gate",
  "version": "0.1.0",
  "description": "SEO regression guard for CI/CD",
  "main": "dist/cli/index.js",
  "bin": {
    "seo-gate": "dist/cli/index.js"
  },
  "type": "module",
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "docs:check": "tsx scripts/check-docs.ts",
    "seo-gate": "tsx src/cli/index.ts"
  },
  "keywords": [
    "seo",
    "ci",
    "cd",
    "regression",
    "gate",
    "quality"
  ],
  "author": "",
  "license": "MIT",
  "packageManager": "pnpm@12.21.0",
  "dependencies": {
    "cheerio": "^1.2.0",
    "commander": "^15.1.0",
    "picocolors": "^1.1.1",
    "playwright": "^1.65.1",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^5.1.1",
    "express": "^5.3.0",
    "fast-glob": "^3.3.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  }
}
